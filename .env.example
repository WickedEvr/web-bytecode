# ----------------------------------------------------
# Configuración del Entorno (Desarrollo / Producción)
# ----------------------------------------------------
NODE_ENV=development

# ----------------------------------------------------
# Configuración de Base de Datos
# ----------------------------------------------------
# Contraseña del usuario 'bytecode_user' para PostgreSQL
DB_PASSWORD=your_secure_db_password_here
# SSL para la base de datos (true/false)
DATABASE_SSL=false

# ----------------------------------------------------
# Seguridad y Autenticación
# ----------------------------------------------------
# Clave secreta para firmar los JSON Web Tokens (JWT)
JWT_SECRET=your_jwt_secret_key_here
# Secreto de validación para webhooks de GitHub
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here

# Configuración de Cookies de Sesión
COOKIE_SECURE=false

# ----------------------------------------------------
# Ajustes de Red y CORS
# ----------------------------------------------------
# URL pública de la API
PUBLIC_API_URL=http://localhost:4000
# Orígenes permitidos para peticiones CORS (separados por comas)
CORS_ORIGINS=http://localhost:5173,http://localhost:4000

# ----------------------------------------------------
# Semillas de Administradores (Opcional)
# ----------------------------------------------------
ADMIN_1_NAME="Admin Uno"
ADMIN_1_EMAIL="admin1@bytecode.com.pe"
ADMIN_1_PASSWORD="BytecodeAdmin2026!"

ADMIN_2_NAME="Admin Dos"
ADMIN_2_EMAIL="admin2@bytecode.com.pe"
ADMIN_2_PASSWORD="BytecodeAdmin2026!"
