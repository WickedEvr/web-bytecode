NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bytecode
DATABASE_SSL=false
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_MAX_USES=7500
JWT_SECRET=change-this-long-random-secret
COOKIE_NAME=bc_admin
COOKIE_SAME_SITE=lax
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PUBLIC_API_URL=http://localhost:4000
MAX_UPLOAD_MB=10
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=bytecode/complaints
CLOUDINARY_UPLOAD_TIMEOUT_MS=30000
CLOUDINARY_CLEANUP_DRY_RUN=true
CLOUDINARY_CLEANUP_LIMIT=50

# Admin bootstrap. Run: npm run db:migrate -w @bytecode/api
ADMIN_1_NAME=Admin 1
ADMIN_1_EMAIL=admin1@bytecode.com.pe
ADMIN_1_PASSWORD=change-me-1
ADMIN_2_NAME=Admin 2
ADMIN_2_EMAIL=admin2@bytecode.com.pe
ADMIN_2_PASSWORD=change-me-2

# Email notifications. If SMTP_* is empty, records are saved but no email is sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
REQUIRE_SMTP=false
SMTP_USER=
SMTP_PASS=
SMTP_MAX_RETRIES=2
MAIL_FROM="Bytecode Web <no-reply@bytecode.com.pe>"
ADMIN_NOTIFICATION_EMAILS=admin1@bytecode.com.pe,admin2@bytecode.com.pe
